        {
          "name": "Set Key on Leader",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var body = pm.response.json();",
                  "  pm.collectionVariables.set('test_key', 'demo');",
                  "  pm.collectionVariables.set('test_version', body.version);",
                  "  pm.test('Key written with version', function() {",
                  "    pm.expect(body.version).to.not.be.undefined;",
                  "    pm.expect(body.key).to.eql('demo');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"demo\",\n  \"value\": \"hello-world\"\n}",
